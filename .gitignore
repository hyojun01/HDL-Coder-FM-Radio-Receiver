# OS and editor files
.DS_Store
Thumbs.db
*~

# MATLAB autosave and temporary files
*.asv
*.m~

# Simulink cache files
*.slxc

# Simulink and MATLAB generated directories
slprj/
sccprj/
codegen/
*_ert_rtw/
*_grt_rtw/

# HDL Coder generated output
hdl_prj/
hdlsrc/

# Simulink Data Dictionary lock files
*.sldd.lock

# MEX binaries
*.mexa64
*.mexmaci64
*.mexmaca64
*.mexw64

# Vivado/Xilinx generated project files
vivado_prj/
.Xil/
*.jou
*.log
*.str

# Python and Jupyter generated files
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Book assets and runnable demo payloads are intentionally tracked.
!docs/
!docs/**/*.pdf
!image/
!image/**/*.jpg
!image/**/*.jpeg
!image/**/*.png
!Chapter_5/Demo/hardware/
